
import {
    VerticalBox,
    HorizontalBox,
    Button,
    LineEdit,
    CheckBox,
    ComboBox,
} from "std-widgets.slint";

component CompressionSlider inherits Rectangle {
    in-out property <float> value: 28;
    in property <color> active-color: #36A66B;

    min-height: 32px;
    min-width: 100px;

    track := Rectangle {
        x: 9px;
        y: 12px;
        width: parent.width - 18px;
        height: 8px;
        border-radius: 4px;
        background: #E0E3E8;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * root.value / 100;
            height: parent.height;
            border-radius: 4px;
            background: root.active-color;
        }
    }

    handle := Rectangle {
        width: 20px;
        height: 20px;
        y: 6px;
        x: track.x + track.width * root.value / 100 - self.width / 2;
        border-radius: 10px;
        background: root.active-color;
        border-width: 2px;
        border-color: #FFFFFF;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.grab;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left
                && event.kind == PointerEventKind.down) {
                root.value = max(0, min(100,
                    (self.mouse-x - 9px) / (self.width - 18px) * 100));
            }
        }

        moved => {
            if (self.pressed) {
                root.value = max(0, min(100,
                    (self.mouse-x - 9px) / (self.width - 18px) * 100));
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Simple Video Compressor";
    width: 850px;
    height: 900px;

    in-out property <string> selected-file: "";
    in-out property <string> output-file-name: "";
    in-out property <string> output-directory: "";

    in-out property <bool> is-dragging-file: false;
    in-out property <bool> drop-zone-hovered: false;

    in-out property <float> compression-level: 28;

    in-out property <bool> multipass-enabled: false;
    in-out property <bool> fast-start-enabled: true;

    in-out property <bool> multipass-available: true;
    in-out property <bool> fast-start-available: true;

    out property <int> crf-value:
        18 + round(root.compression-level * 0.18);

    out property <color> quality-color:
        root.compression-level <= 0 ? #3986DB :
        root.compression-level <= 28 ? #36A66B :
        root.compression-level <= 56 ? #D6A72E :
        #DC5555;

    out property <string> quality-description:
        root.compression-level <= 0 ? "Лучшее качество" :
        root.compression-level <= 28 ? "Хорошее качество" :
        root.compression-level <= 56 ? "Заметная потеря качества" :
        "Сильное сжатие";

    in-out property <string> video-resolution: "";
    in-out property <string> video-duration: "";
    in-out property <string> video-fps: "";
    in-out property <string> video-codec: "";
    in-out property <string> video-size: "";
    in-out property <string> output-full-path: "";

    in-out property <int> container-index: 0;
    in-out property <int> codec-index: 0;
    in-out property <int> encoder-index: 0;
    in-out property <[string]> encoder-presets: ["medium"];
    in-out property <int> preset-index: 0;

    callback choose-file();
    callback output-file-name-changed(string);
    callback output-file-name-editing-finished();
    callback choose-output-directory();
    callback multipass-changed(bool);
    callback fast-start-changed(bool);
    callback container-changed(string);
    callback codec-changed(string);
    callback encoder-changed(string);
    callback preset-changed(string);

    public function finish-output-name-editing() {
        root.output-file-name-editing-finished();
        output-name-input.clear-focus();
    }

    TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            output-name-input.clear-focus();
        }
    }

    VerticalBox {
        padding: 24px;
        spacing: 12px;

        // Единая зона Drag & Drop и информации о видео
        Rectangle {
            width: 100%;
            height: 280px;
            border-width: 2px;
            border-radius: 10px;
            border-color: root.drop-zone-hovered ? #36A66B : #555555;
            background: root.drop-zone-hovered ? #263B32 : #252525;

            if root.selected-file == "": Text {
                text: "Перетащите видео сюда";
                color: #FFFFFF;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.selected-file != "": VerticalBox {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: "Информация о видео";
                    font-size: 16px;
                    font-weight: 700;
                    color: #FFFFFF;
                    horizontal-alignment: left;
                }

                HorizontalBox {
                    spacing: 0px;

                    Text {
                        width: 130px;
                        text: "Имя файла:";
                        color: #AAAAAA;
                        horizontal-alignment: left;
                    }

                    Text {
                        text: root.selected-file;
                        color: #FFFFFF;
                        horizontal-alignment: left;
                    }
                }

                HorizontalBox {
                    spacing: 0px;

                    Text {
                        width: 130px;
                        text: "Разрешение:";
                        color: #AAAAAA;
                        horizontal-alignment: left;
                    }

                    Text {
                        text: root.video-resolution == "" ? "—" : root.video-resolution;
                        color: #FFFFFF;
                        horizontal-alignment: left;
                    }
                }

                HorizontalBox {
                    spacing: 0px;

                    Text {
                        width: 130px;
                        text: "Длительность:";
                        color: #AAAAAA;
                        horizontal-alignment: left;
                    }

                    Text {
                        text: root.video-duration == "" ? "—" : root.video-duration;
                        color: #FFFFFF;
                        horizontal-alignment: left;
                    }
                }

                HorizontalBox {
                    spacing: 0px;

                    Text {
                        width: 130px;
                        text: "FPS:";
                        color: #AAAAAA;
                        horizontal-alignment: left;
                    }

                    Text {
                        text: root.video-fps == "" ? "—" : root.video-fps;
                        color: #FFFFFF;
                        horizontal-alignment: left;
                    }
                }

                HorizontalBox {
                    spacing: 0px;

                    Text {
                        width: 130px;
                        text: "Кодек:";
                        color: #AAAAAA;
                        horizontal-alignment: left;
                    }

                    Text {
                        text: root.video-codec == "" ? "—" : root.video-codec;
                        color: #FFFFFF;
                        horizontal-alignment: left;
                    }
                }

                HorizontalBox {
                    spacing: 0px;

                    Text {
                        width: 130px;
                        text: "Размер файла:";
                        color: #AAAAAA;
                        horizontal-alignment: left;
                    }

                    Text {
                        text: root.video-size == "" ? "—" : root.video-size;
                        color: #FFFFFF;
                        horizontal-alignment: left;
                    }
                }
            }
        }

        // Кнопка выбора видео
        Button {
            text: "Выбрать видео";
            clicked => {
                root.choose-file();
            }
        }

        // Настройки выходного файла
        Text {
            text: "Выходной файл";
            color: #FFFFFF;
            font-size: 18px;
            font-weight: 600;
        }

        output-name-input := LineEdit {
            text <=> root.output-file-name;
            placeholder-text: "Введите имя файла";

            edited(text) => {
                root.output-file-name = text;
                root.output-file-name-changed(text);
            }

            accepted(text) => {
                root.output-file-name = text;
                root.output-file-name-changed(text);
                root.output-file-name-editing-finished();
                self.clear-focus();
            }
        }

        HorizontalBox {
            spacing: 8px;
            alignment: start;

            Button {
                width: 130px;
                text: "Выбрать папку";

                clicked => {
                    root.choose-output-directory();
                }
            }

            Text {
                width: 130px;
                text: "Папка сохранения:";
                color: #AAAAAA;
                font-size: 13px;
                vertical-alignment: center;
            }

            Text {
                text: root.output-directory == "" ? "—" : root.output-directory;
                color: #AAAAAA;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Итоговый путь выходного файла
        HorizontalBox {
            spacing: 8px;

            Text {
                text: "Итоговый файл:";
                color: #AAAAAA;
                font-size: 13px;
                vertical-alignment: center;
            }

            Text {
                text: root.output-full-path == "" ? "—" : root.output-full-path;
                color: #FFFFFF;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Единый блок настроек кодирования
        Rectangle {
            width: 100%;
            border-width: 1px;
            border-radius: 10px;
            border-color: #444444;
            background: #252525;

            VerticalBox {
                padding: 10px;
                spacing: 6px;

                Text {
                    text: "Настройки кодирования";
                    color: #FFFFFF;
                    font-size: 18px;
                    font-weight: 600;
                }

                // Первый ряд: контейнер, кодек, разрешение
                HorizontalBox {
                    spacing: 16px;

                    // Первая колонка
                    VerticalBox {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        VerticalBox {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: "Контейнер";
                                color: #AAAAAA;
                                font-size: 12px;
                            }

                            ComboBox {
                                model: ["MP4", "MKV"];
                                current-index: root.container-index;

                                selected(value) => {
                                    root.container-changed(value);
                                }
                            }
                        }

                        VerticalBox {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: "Кодировщик";
                                color: #AAAAAA;
                                font-size: 12px;
                            }

                            ComboBox {
                                model: ["Software (CPU)", "NVIDIA NVENC", "AMD AMF", "Intel Quick Sync (QSV)"];

                                current-index: root.encoder-index;

                                selected(value) => {
                                    root.encoder-changed(value);
                                }
                            }
                        }
                    }

                    // Вторая колонка
                    VerticalBox {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        VerticalBox {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: "Видеокодек";
                                color: #AAAAAA;
                                font-size: 12px;
                            }

                            ComboBox {
                                model: ["H.264", "H.265"];
                                current-index: root.codec-index;

                                selected(value) => {
                                    root.codec-changed(value);
                                }
                            }
                        }

                        VerticalBox {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: "Пресет";
                                color: #AAAAAA;
                                font-size: 12px;
                            }

                            ComboBox {
                                model: root.encoder-presets;
                                current-index: root.preset-index;

                                selected(value) => {
                                    root.preset-changed(value);
                                }
                            }
                        }
                    }

                    VerticalBox {
                        horizontal-stretch: 1;
                        spacing: 4px;

                        Text {
                            text: "Разрешение";
                            color: #AAAAAA;
                            font-size: 12px;
                        }

                        Text {
                            text: "Оригинал";
                            color: #CCCCCC;
                            vertical-alignment: center;
                        }
                    }
                }

                // Ползунок степени сжатия
                HorizontalBox {
                    spacing: 12px;

                    Text {
                        text: "Степень сжатия:";
                        color: #FFFFFF;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "\{round(root.compression-level)} / 100";
                        color: root.quality-color;
                        vertical-alignment: center;
                    }

                    CompressionSlider {
                        horizontal-stretch: 1;
                        value <=> root.compression-level;
                        active-color: root.quality-color;
                        max-height: 30px;
                        min-height: 20px;
                    }
                }

                HorizontalBox {
                    spacing: 12px;

                    Text {
                        text: root.quality-description;
                        color: root.quality-color;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "CRF \{root.crf-value}";
                        color: #888888;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                // Четвёртый ряд: дополнительные параметры
                HorizontalBox {
                    spacing: 24px;

                    CheckBox {
                        text: "Multipass";
                        checked: root.multipass-enabled;
                        enabled: root.multipass-available;

                        toggled => {
                            root.multipass-changed(self.checked);
                        }
                    }

                    CheckBox {
                        text: "Fast Start";
                        checked: root.fast-start-enabled;
                        enabled: root.fast-start-available;

                        toggled => {
                            root.fast-start-changed(self.checked);
                        }
                    }
                }
            }
        }
    }
}
