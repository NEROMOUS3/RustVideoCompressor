
import { VerticalBox, Button } from "std-widgets.slint";

component CompressionSlider inherits Rectangle {
    in-out property <float> value: 28;
    in property <color> active-color: #36A66B;

    min-height: 32px;
    min-width: 100px;

    // Фоновая дорожка
    track := Rectangle {
        x: 9px;
        y: 12px;
        width: parent.width - 18px;
        height: 8px;
        border-radius: 4px;
        background: #E0E3E8;

        // Заполненная часть
       Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * root.value / 100;
            height: parent.height;
            border-radius: 4px;
            background: root.active-color;
        }
    }

    // Круглый ползунок
    handle := Rectangle {
        width: 20px;
        height: 20px;
        y: 6px;
        x: track.x + track.width * root.value / 100 - self.width / 2;
        border-radius: 10px;
        background: root.active-color;
        border-width: 2px;
        border-color: #FFFFFF;
    }

    // Обработка мыши
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.grab;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left
                && event.kind == PointerEventKind.down) {
                root.value = max(0, min(100,
                    (self.mouse-x - 9px) / (self.width - 18px) * 100));
            }
        }

        moved => {
            if (self.pressed) {
                root.value = max(0, min(100,
                    (self.mouse-x - 9px) / (self.width - 18px) * 100));
            }
        }
    }
}


export component MainWindow inherits Window {
    title: "Rust Video Compressor";
    width: 850px;
    height: 700px;

    in-out property <string> selected-file: "";
    callback choose-file();

    in-out property <bool> is-dragging-file: false;
    in-out property <bool> drop-zone-hovered: false;

    in-out property <float> compression-level: 28;

    out property <int> crf-value:
        18 + round(root.compression-level * 0.18);

    out property <color> quality-color:
        root.compression-level <= 0 ? #3986DB :
        root.compression-level <= 28 ? #36A66B :
        root.compression-level <= 56 ? #D6A72E :
        #DC5555;

    out property <string> quality-description:
        root.compression-level <= 0 ? "Лучшее качество" :
        root.compression-level <= 28 ? "Хорошее качество" :
        root.compression-level <= 56 ? "Заметная потеря качества" :
        "Сильное сжатие";

    VerticalBox {
        padding: 24px;
        spacing: 16px;

        Rectangle {
            height: 130px;
            border-width: 2px;
            border-radius: 10px;
            border-color: root.drop-zone-hovered ? #36A66B : #555555;
            background: root.drop-zone-hovered ? #263B32 : #252525;

            Text {
                text: "Перетащите видео сюда";
                color: #FFFFFF;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Button {
            text: "Выбрать видео";
            clicked => {
                root.choose-file();
            }
        }

        Text {
            text: root.selected-file == ""
                ? "Видео не выбрано"
                : root.selected-file;
            color: #AAAAAA;
            font-size: 13px;
        }

        Text {
            text: "Степень сжатия";
            font-size: 20px;
            font-weight: 600;
        }

        Text {
            text: "Уровень: \{round(root.compression-level)} / 100";
            font-size: 24px;
            color: root.quality-color;
            font-weight: 700;
        }

        CompressionSlider {
            value <=> root.compression-level;
            active-color: root.quality-color;
        }

        Text {
            text: root.quality-description;
            color: root.quality-color;
            font-size: 16px;
            font-weight: 600;
        }

        Text {
            text: "Параметр кодирования H.264: CRF \{root.crf-value}";
            color: #888888;
            font-size: 13px;
        }
    }
}
